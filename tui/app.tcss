Screen {
    background: $surface;

    /* Keep selectable output as readable as the prompt editor selection. */
    & > .screen--selection {
        background: $input-selection-background;
        color: $input-selection-foreground;
    }
}

#screen {
    height: 1fr;
    padding: 1 2;
}

#workspace {
    height: 1fr;
}

#task-sidebar {
    width: 44;
    min-width: 22;
    height: 1fr;
    border: round $primary;
    padding: 1;
}

#task-list {
    height: 1fr;
}

#project-main {
    width: 1fr;
    padding-left: 1;
}

#project-label {
    width: 9;
    color: $text-muted;
}

#project-select {
    width: 1fr;
    margin-right: 1;
}

#task-label {
    color: $text-accent;
    text-style: bold;
    height: 2;
}

/* The project selector now sits in the task toolbar. */
#task-bar #project-label {
    height: auto;
    margin-right: 1;
}

#task-bar #project-select {
    width: 1fr;
}

#title {
    color: $text-accent;
    text-style: bold;
}

#settings {
    height: 3;
    align: left middle;
}

#task-bar {
    height: 3;
    align: left middle;
}

#new-task-button {
    width: 14;
}

#settings Select {
    width: 1fr;
    margin-right: 1;
}

#directory, #phase, #title, #task-context, #status,
#resume-notes-label, #task-error {
    color: $text-muted;
    pointer: text;
}

#directory, #phase {
    height: 1;
}

#task-context {
    color: $text-muted;
    height: 2;
}

#task-error {
    color: $error;
    height: 3;
    min-height: 1;
    border: none;
    padding: 0;
}

#output {
    height: 1fr;
    border: round $primary;
    padding: 1;
    /* Keep progress narration quiet until the agent's final summary. */
    color: $text-disabled;
}

#plan-review {
    display: none;
    height: 1fr;
    border: round $primary;
    padding: 1;
    overflow-y: auto;
}

#plan-display {
    color: $text;
    height: auto;
    margin-bottom: 1;
}

#plan-questions {
    height: auto;
}

.plan-questions-heading {
    color: $text-accent;
    text-style: bold;
    height: 1;
}

.plan-question {
    color: $text;
    height: auto;
    margin-top: 1;
}

#plan-questions Select {
    width: 1fr;
    margin-top: 1;
}

#plan-actions {
    height: 3;
    align: left middle;
    margin-top: 1;
}

#answer-plan-button, #implement-button {
    width: 18;
    margin-right: 1;
}

#implement-button.implemented {
    color: $text-disabled;
    opacity: 0.55;
}

#prompt-input {
    color: $text;
}

#prompt-input.-read-only {
    /* Submitted prompts are still selectable, but are no longer editable. */
    color: $text-disabled 75%;
}

#composer {
    height: auto;
    min-height: 7;
}

#prompt-input {
    height: 7;
    border: round $secondary;
}

#resume-notes-panel {
    display: none;
    height: 5;
}

#resume-notes-label {
    color: $text-muted;
    height: 1;
}

#resume-notes {
    height: 3;
    border: round $secondary;
}

#actions {
    height: 3;
    align: left middle;
}

#send-button {
    width: 12;
    margin-right: 2;
}

#continue-plan-button, #start-coding-button {
    width: 16;
    margin-right: 1;
}

#pause-button, #resume-button, #cancel-button {
    width: 11;
    margin-right: 1;
}

#retry-button {
    width: 11;
    margin-right: 1;
}

#status {
    color: $text-muted;
}

KeyboardShortcutsScreen {
    align: center middle;
}

CodingStatisticsScreen {
    align: center middle;
}

#coding-statistics-dialog {
    width: 94%;
    height: 88%;
    border: round $primary;
    background: $surface;
    padding: 1 2;
}

#coding-statistics-title {
    color: $text-accent;
    text-style: bold;
    height: 2;
}

#coding-statistics-subtitle, #coding-statistics-footer {
    color: $text-muted;
    height: 1;
}

#coding-statistics-controls {
    height: 3;
    align: left middle;
}

#statistics-unit-label {
    width: 9;
    color: $text-muted;
}

#statistics-unit-select {
    width: 18;
}

#coding-statistics-summary {
    height: 5;
    margin-top: 1;
}

.usage-metric {
    width: 1fr;
    border: round $secondary;
    padding: 1;
    color: $text-accent;
    text-style: bold;
    margin-right: 1;
}

#coding-statistics-body {
    height: 1fr;
    margin-top: 1;
}

#usage-history-panel {
    width: 58%;
    border: round $primary;
    padding: 1;
    margin-right: 1;
}

#usage-breakdown-panel {
    width: 42%;
    border: round $primary;
    padding: 1;
}

.statistics-heading {
    color: $text-accent;
    text-style: bold;
    height: 2;
}

.statistics-value {
    color: $text;
    height: 3;
    margin-bottom: 1;
}

#provider-split {
    height: auto;
}

#usage-table {
    height: 1fr;
}

#shortcuts-dialog {
    width: 72;
    max-height: 90%;
    border: round $primary;
    background: $surface;
    padding: 1 2;
}

#shortcuts-title {
    color: $text-accent;
    text-style: bold;
    height: 2;
}

#shortcuts-subtitle {
    color: $text-muted;
    height: 2;
}

.shortcut-section {
    color: $text-accent;
    text-style: bold;
    height: 1;
    margin-top: 1;
}

.shortcut-row {
    height: 1;
}
